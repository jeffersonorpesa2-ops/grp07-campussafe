# =====================================================================
# CampusSafe: Campus Hazard & Safety Reporting System
# Environment Configuration Template
# =====================================================================

APP_NAME="CampusSafe"
APP_ENV=local
APP_DEBUG=true
APP_URL="http://localhost:8000"

# Database Connection Configuration
# Note: Default PostgreSQL port is 5432. If your machine runs PG14 on port 5433, change DB_PORT to 5433.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=grp07_campussafedb
DB_USER=campussafe_app
DB_PASSWORD=change_me_locally

# File Upload Configuration
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# Seed Settings (Default demo password for seed accounts)
DEMO_PASSWORD=Password123!
